{
  "name": "sonora-music-player",
  "version": "1.2.0",
  "description": "Premium desktop music player built with Electron, React, and TypeScript",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && electron-builder --mac",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "keywords": [
    "music-player",
    "electron",
    "typescript",
    "audio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "music-metadata": "^11.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.sonora.player",
    "productName": "Sonora",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "mp3",
        "name": "Sonora.mp3",
        "description": "MP3 Audio File",
        "role": "Viewer",
        "mimeType": "audio/mpeg"
      },
      {
        "ext": "flac",
        "name": "Sonora.flac",
        "description": "FLAC Audio File",
        "role": "Viewer",
        "mimeType": "audio/flac"
      },
      {
        "ext": "wav",
        "name": "Sonora.wav",
        "description": "WAV Audio File",
        "role": "Viewer",
        "mimeType": "audio/wav"
      },
      {
        "ext": "m4a",
        "name": "Sonora.m4a",
        "description": "M4A Audio File",
        "role": "Viewer",
        "mimeType": "audio/mp4"
      },
      {
        "ext": "aac",
        "name": "Sonora.aac",
        "description": "AAC Audio File",
        "role": "Viewer",
        "mimeType": "audio/aac"
      },
      {
        "ext": "ogg",
        "name": "Sonora.ogg",
        "description": "OGG Audio File",
        "role": "Viewer",
        "mimeType": "audio/ogg"
      },
      {
        "ext": "opus",
        "name": "Sonora.opus",
        "description": "OPUS Audio File",
        "role": "Viewer",
        "mimeType": "audio/opus"
      },
      {
        "ext": "wma",
        "name": "Sonora.wma",
        "description": "WMA Audio File",
        "role": "Viewer",
        "mimeType": "audio/x-ms-wma"
      }
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sonora",
      "artifactName": "Sonora Setup ${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Sonora Portable ${version}.${ext}"
    },
    "mac": {
      "icon": "public/icon.png",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "public/icon.png",
      "category": "Audio",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
